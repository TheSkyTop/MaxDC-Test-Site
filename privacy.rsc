1:["$","main",null,{"children":[["$","div",null,{"className":"plain-header","children":["$","$Le",null,{"dark":true}]}],["$","article",null,{"className":"legal shell section","children":[["$","p",null,{"className":"eyebrow","children":"Legal information"}],["$","h1",null,{"children":"Privacy notice"}],["$","p",null,{"className":"legal-date","children":"Last updated 6 September 2026"}],["$","div",null,{"className":"legal-copy","children":[["$","p",null,{"className":"legal-intro","children":"This notice explains how MaxDC handles personal information received through this website and related business enquiries. Our approach is informed by the Privacy Act 1988 (Cth) and the Australian Privacy Principles where they apply."}],["$","section",null,{"children":[["$","h2",null,{"children":"Information we may collect"}],["$","p",null,{"children":"We may collect your name, business contact details, organisation, role and the information you include in an enquiry. Our hosting and security services may also receive standard technical information such as browser type, device information, IP address and requested pages."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"How information is collected"}],["$","p",null,{"children":"Information is generally collected directly from you when you contact MaxDC, submit an enquiry, attend a meeting or correspond with us. We may also receive professional contact information from public business sources, advisers or project counterparties."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"How we use information"}],["$","p",null,{"children":"We use personal information to respond to enquiries, assess potential sites and partnerships, conduct due diligence, manage business relationships, maintain website security and meet legal or regulatory obligations."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Disclosure and service providers"}],["$","p",null,{"children":"Information may be shared where reasonably necessary with MaxDC personnel, professional advisers, technology and hosting providers, project counterparties, financiers or public authorities. We do not sell personal information. Service providers may process information in Australia or other jurisdictions subject to their contractual and legal safeguards."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Security and retention"}],["$","p",null,{"children":"We take reasonable administrative and technical steps to protect information from misuse, loss and unauthorised access. Information is retained only for as long as reasonably required for the relevant business, legal, security or record-keeping purpose, then securely deleted or de-identified where practicable."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Access, correction and concerns"}],["$","p",null,{"children":"You may ask to access or correct personal information held about you, or raise a privacy concern, through the MaxDC contact page. We may need to verify your identity and will respond within a reasonable period. You may also contact the Office of the Australian Information Commissioner for information about privacy rights."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Updates"}],["$","p",null,{"children":"We may update this notice as our website, services or legal obligations change. The current version will be made available on this website."}]]}]]}]]}],["$","$Lf",null,{}]]}]
